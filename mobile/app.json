{
	"expo": {
		"name": "univocal",
		"slug": "univocal",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "univocal",
		"userInterfaceStyle": "light",
		"ios": {
			"userInterfaceStyle": "light",
			"supportsTablet": true,
			"bundleIdentifier": "de.saukels.univocal",
            "infoPlist": {
                "UIDesignRequiresCompatibility": true
            },
            "icon": "./assets/images/app.icon"
		},
		"android": {
			"userInterfaceStyle": "light",
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "de.saukels.univocal",
			"intentFilters": [
				{
					"action": "VIEW",
					"autoVerify": false,
					"data": [
						{
							"scheme": "univocal",
							"host": "auth",
							"pathPrefix": "/dfn"
						}
					],
					"category": ["BROWSABLE", "DEFAULT"]
				}
			]
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff"
				}
			],
			"expo-secure-store",
			"expo-font",
			"expo-web-browser",
            "expo-notifications",
            "expo-status-bar",
            "@react-native-community/datetimepicker"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
            "eas": {
                "projectId": "6812a991-39f4-49be-a404-4f73179fd00c"
            }
		}
	}
}
