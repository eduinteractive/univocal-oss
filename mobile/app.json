{
	"expo": {
		"name": "SV-Hub",
		"slug": "svhub",
		"version": "1.1.1",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "SVHub",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"ios": {
			"userInterfaceStyle": "light",
			"supportsTablet": true,
			"bundleIdentifier": "de.saukels.svhub"
		},
		"android": {
			"userInterfaceStyle": "light",
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "de.saukels.svhub"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff"
				}
			],
			"expo-secure-store",
			"expo-font",
			"expo-web-browser",
            "expo-notifications"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "5f39ce5b-a681-476c-a1d9-76787088e133"
			}
		}
	}
}
