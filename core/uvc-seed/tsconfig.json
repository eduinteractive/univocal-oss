{
	"compilerOptions": {
		"target": "ES2015",
		"module": "commonjs",
		"lib": ["es6"],
		"types": ["node"],
		"outDir": "build",
		"rootDir": ".",
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["./build", "./node_modules"]
}
